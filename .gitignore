# Material fuente de clientes (dron, brandbooks, packshots, entregas) — nunca se versiona
raw/

# ── Binarios y media pesada: se rebajan o se reconstruyen, no se versionan ──
# (revisado 26-08-2026: eran 250 MB entre ffmpeg, whisper y los assets del personaje)
tools/ffmpeg
tools/ffmpeg.zip
tools/__MACOSX/
whisper.cpp/
image.png
__MACOSX/

# gcl-agent: viajan las biblias (.md), no los renders ni las voces
gcl-agent/**/*.png
gcl-agent/**/*.mp3
gcl-agent/**/*.wav
gcl-agent/**/*.svg
gcl-agent/_descartado-v1/

# assets/ de trabajo suelto en la RAÍZ. La barra inicial importa: sin ella,
# `assets/` también matchea public/assets/ y se lleva puesto todo el núcleo.
/assets/

# Cache de Python — se regenera solo
__pycache__/
*.pyc

# ── public/assets: viaja el NÚCLEO (18 MB), no el material (1,3 GB) ──────────
# Decisión 26-08-2026 (opción 1 de docs/ONBOARDING-DISENADORES.md paso 5).
# Con esto, `git clone` + `npm install` deja el estudio listo para renderizar.
# Las fotos, packshots y video se bajan del Drive por marca, cuando hagan falta.
public/assets/**
!public/assets/**/
# Fuentes libres y las de licencia que sí podemos repartir
!public/assets/**/*.ttf
!public/assets/**/*.otf
!public/assets/**/*.woff
!public/assets/**/*.woff2
# Logos oficiales
!public/assets/**/logo*.png
!public/assets/**/logo*.svg
!public/assets/**/Logo*.png
!public/assets/**/*-logo.svg
!public/assets/**/tc_logo*.png
!public/assets/brand/**
# Fondos de la grilla Revex septiembre 2026 (29 MB). Excepción deliberada:
# los scripts scripts/revex-*.py no corren sin estas fotos, y sin ellas cada
# ronda de correcciones vuelve a empezar de cero en otra máquina (27-08-2026).
!public/assets/revex/sep/**
# CAVA: los bottle shots y sus versiones 2x (upscaler de precisión) son el
# material con el que se montan los KV. Sin ellos otro diseñador no reproduce la
# entrega — se cae al packshot chico y el bodegón sale distinto.
!public/assets/cava/bottles/**
!public/assets/cava/kv/**

# Material de la grilla Casablanca septiembre 2026 (39 MB). Misma excepción
# deliberada que Revex: scripts/casablanca-septiembre.py no corre sin estas 14
# imágenes. Se listan por patrón exacto —lo que el script abre— y no la carpeta
# entera, para no arrastrar los intermedios de Freepik (27-08-2026).
!public/assets/casablanca/muestra_*.png
!public/assets/casablanca/sep/amb_*_feed.jpg
!public/assets/casablanca/sep/sr2_*.jpg
!public/assets/casablanca/sep/amb_*_feed45.jpg

# ⛔ Estas NO se versionan aunque sean fuentes — la licencia lo impide:
#    IvyOra = Adobe Fonts (cada persona la activa en su Creative Cloud)
#    Agrandir = de pago, licencia del cliente Selfie (se pide a Coni)
public/assets/fonts/ivyora/
public/assets/fonts/selfie/
out/*/_subidas.json

# Landing Strip Center Algarrobal — Más Center (28-08-2026). Excepción deliberada,
# misma lógica que Revex y Casablanca: es una entrega viva (publicada en Vercel) y
# sin su HTML, iconos y fuentes hay que rehacerla de cero en otra máquina.
# Ojo: arriba `out/` pasó a `out/*` porque git no entra a una carpeta excluida.
!out/mascenter-algarrobal/
!out/mascenter-algarrobal/**
# Los dos MP4 no viajan (14,7 MB): se reconstruyen con scripts/algarrobal-video-web.sh
out/mascenter-algarrobal/**/*.mp4
# La versión con todo incrustado para el artifact (11,5 MB) se regenera cuando haga falta
out/mascenter-algarrobal/preview-artifact.html

# Material de la RONDA 4 de Between septiembre 2026 (27-08-2026). Misma excepción
# deliberada que Revex y Casablanca: son las escenas que el cliente pidió rehacer
# y que NO se reproducen solas —cada una salió de una generación con IA y lleva el
# logotipo real estampado encima con scripts/between-logo-vaso.py—. Sin ellas, la
# ronda hay que rehacerla de cero en otra máquina, que es justo lo que ya pasó tres
# veces con esta cuenta. Se listan por archivo, no la carpeta, para no arrastrar
# los intermedios de Freepik.
!public/assets/hilton/between/ia-sept/cumple-manos-logo.png
!public/assets/hilton/between/ia-sept/cumple-vela-logo.png

