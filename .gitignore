# Material fuente de clientes (dron, brandbooks, packshots, entregas) — nunca se versiona
raw/

# ── Binarios y media pesada: se rebajan o se reconstruyen, no se versionan ──
# (revisado 26-08-2026: eran 250 MB entre ffmpeg, whisper y los assets del personaje)
tools/ffmpeg
tools/ffmpeg.zip
tools/__MACOSX/
whisper.cpp/
image.png
__MACOSX/

# gcl-agent: viajan las biblias (.md), no los renders ni las voces
gcl-agent/**/*.png
gcl-agent/**/*.mp3
gcl-agent/**/*.wav
gcl-agent/**/*.svg
gcl-agent/_descartado-v1/

# assets/ de trabajo suelto en la RAÍZ. La barra inicial importa: sin ella,
# `assets/` también matchea public/assets/ y se lleva puesto todo el núcleo.
/assets/

# Cache de Python — se regenera solo
__pycache__/
*.pyc

# ── public/assets: viaja el NÚCLEO (18 MB), no el material (1,3 GB) ──────────
# Decisión 26-08-2026 (opción 1 de docs/ONBOARDING-DISENADORES.md paso 5).
# Con esto, `git clone` + `npm install` deja el estudio listo para renderizar.
# Las fotos, packshots y video se bajan del Drive por marca, cuando hagan falta.
public/assets/**
!public/assets/**/
# Fuentes libres y las de licencia que sí podemos repartir
!public/assets/**/*.ttf
!public/assets/**/*.otf
!public/assets/**/*.woff
!public/assets/**/*.woff2
# Logos oficiales
!public/assets/**/logo*.png
!public/assets/**/logo*.svg
!public/assets/**/Logo*.png
!public/assets/**/*-logo.svg
!public/assets/**/tc_logo*.png
!public/assets/brand/**
# Fondos de la grilla Revex septiembre 2026 (29 MB). Excepción deliberada:
# los scripts scripts/revex-*.py no corren sin estas fotos, y sin ellas cada
# ronda de correcciones vuelve a empezar de cero en otra máquina (27-08-2026).
!public/assets/revex/sep/**

# ⛔ Estas NO se versionan aunque sean fuentes — la licencia lo impide:
#    IvyOra = Adobe Fonts (cada persona la activa en su Creative Cloud)
#    Agrandir = de pago, licencia del cliente Selfie (se pide a Coni)
public/assets/fonts/ivyora/
public/assets/fonts/selfie/
